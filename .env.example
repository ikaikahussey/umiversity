# Neon Postgres (pooled connection string)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Neon Auth
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
# Vercel Blob (private badge evidence)
BLOB_READ_WRITE_TOKEN=
# YouTube Data API v3 (nightly resource suggestions)
YOUTUBE_API_KEY=
# Resend (reminders and digests)
RESEND_API_KEY=
EMAIL_FROM="Umiversity <noreply@example.org>"
# Shared secret Vercel Cron sends as a bearer token
CRON_SECRET=
# Stripe Connect (phase 6)
STRIPE_SECRET_KEY=
# Public site URL used in emails and Stripe return links
APP_URL=http://localhost:3000
# Votes needed to promote a request to a draft course
REQUEST_PROMOTE_THRESHOLD=25
