{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "sh scripts/vercel-build.sh",
  "crons": [
    {
      "path": "/api/cron/streaks",
      "schedule": "10 10 * * *"
    },
    {
      "path": "/api/cron/youtube",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 18 * * 0"
    },
    {
      "path": "/api/cron/payouts",
      "schedule": "0 12 2 * *"
    }
  ]
}
